{
  "name": "acd",
  "version": "0.1.0",
  "description": "Mapa canónico de un PDF: de una posición en el PDF a su referencia canónica (II d. 3 n. 29, 327a, 1094a1).",
  "license": "MIT",
  "author": "José Pablo Iglesias",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predemo": "node scripts/copy-pdfjs.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "node scripts/copy-pdfjs.mjs && vite build --config demo/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
